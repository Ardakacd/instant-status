{
  "expo": {
    "name": "Instant Status",
    "slug": "instant-status",
    "scheme": "instant-status",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "7",
      "appleTeamId": "FPQ5Q94QY6",
      "bundleIdentifier": "com.arda.instantstatusapp",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.com.arda.instantstatusapp"
        ]
      },
      "associatedDomains": ["applinks:instantstatus.app"]
    },
    "android": {
      "package": "com.arda.instantstatusapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "notification": {
        "icon": "assets/notification-icon.png",
        "color": "#007AFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECEIVE_BOOT_COMPLETED", "POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "instantstatus.app",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "instantstatus.app",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "instantstatus.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#10B981"
      }
    },
    "web": {
      "favicon": "./assets/favicon.ico",
      "bundler": "metro",
      "output": "single",
      "name": "Instant Status",
      "shortName": "Instant Status",
      "lang": "en",
      "scope": "/",
      "themeColor": "#10B981",
      "backgroundColor": "#10B981",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "icons": [
        {
          "src": "./assets/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        },
        {
          "src": "./assets/web-app-manifest-512x512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10B981",
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "cover",
          "android": {
            "backgroundColor": "#10B981",
            "image": "./assets/splash.png",
            "imageWidth": 300,
            "resizeMode": "cover"
          },
          "ios": {
            "backgroundColor": "#10B981",
            "image": "./assets/splash.png",
            "resizeMode": "cover"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.70279102156-1hdnc7rnv4mlumb4ldifsdm1at2ejka1"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"]
          }
        }
      ],
      "@bacons/apple-targets",
      "./withFollyCoroutineFix.js",
      "./withNotifeeMavenRepo.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "InstantStatusWidget",
              "label": "Instant Status",
              "description": "See your friends' current status.",
              "preview": "InstantStatusWidgetPreviewScreen",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "arda-kabadayi",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d4314124-26b3-4693-a96f-35ea529a0ad1"
      },
      "environment": "development"
    },
    "owner": "ardaka"
  }
}
